{
  "name": "meal-wizard",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run --exclude tests/firestore.rules.test.ts --exclude .worktrees/** --exclude apps/**",
    "test:client": "vitest run tests --exclude tests/firestore.rules.test.ts --exclude .worktrees/**",
    "test:functions": "npm --prefix functions test",
    "build:functions": "npm --prefix functions run build",
    "test:rules:vitest": "vitest run tests/firestore.rules.test.ts --exclude .worktrees/**",
    "test:rules": "firebase emulators:exec --only firestore --project demo-meal-wizard-rules \"npm run test:rules:vitest\"",
    "test:tagging-eval": "vitest run tests/catalogueTaggingEvaluation.test.mjs",
    "test:meal-type-eval": "vitest run tests/catalogueMealTypeEvaluation.test.mjs",
    "canary:taxonomy-v2": "npm run build:functions && node scripts/runTaxonomyV2Canary.mjs",
    "release:ota:check": "node scripts/release-ota.mjs",
    "release:ota": "node scripts/release-ota.mjs --publish",
    "scan:client-secrets": "node scripts/scanClientSecrets.mjs",
    "verify:phase0": "npm run test:functions && npm run build:functions && npm run test:client && npm run test:rules && npm run lint && tsc --noEmit && npm run scan:client-secrets",
    "verify:phase2:local": "npm run test:functions && npm run build:functions && npm run test:client && npm run test:rules && npm run lint && tsc --noEmit && npm run scan:client-secrets",
    "verify:phase3:local": "npm run test:functions && npm run build:functions && npm run test:rules && npm run scan:client-secrets && node scripts/verifyPhase3Static.mjs",
    "verify:phase4:local": "npm run test:functions && npm run build:functions && npm run test:rules && npm run scan:client-secrets && node scripts/verifyPhase4Static.mjs",
    "verify:final:local": "npm run test:functions && npm run build:functions && npm run test:client && npm run test:rules && npm run lint && tsc --noEmit && npm run scan:client-secrets && node scripts/verifyFinalCatalogueStatic.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "^57.0.22",
    "expo-auth-session": "~57.0.12",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@google-cloud/secret-manager": "^6.1.0",
    "@types/react": "~19.2.10",
    "dotenv": "^16.4.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-admin": "^13.9.0",
    "firebase-tools": "^14.9.0",
    "playwright": "^1.59.1",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "private": true
}
