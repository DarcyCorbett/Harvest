rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profiles ───────────────────────────────────
    // Clients may read their own profile. Server callables own profile writes.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // ─── Households ──────────────────────────────────────
    // Clients may read a household they belong to. Server callables own
    // household creation, membership changes, switching, and invite lookups.
    match /households/{householdId} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow list, create, update, delete: if false;

      // Household subcollections — only members can access
      match /mealPlan/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      match /shoppingList/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      match /cookbook/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      match /settings/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      match /generationResult/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      match /state/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }

    // Invite-code reservations are an internal, server-only lookup table.
    match /householdInvites/{inviteCode} {
      allow read, write: if false;
    }

    // ─── Recipes (Global Cache) ──────────────────────────
    // Authenticated clients can read recipes. Server callables own all writes.
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // ─── Recipe Discovery Index ──────────────────────────
    // Authenticated clients can read the legacy index. Server callables own all writes.
    match /recipeIndex/{site}/recipes/{recipeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // ─── Allowlist (pre-auth read for email gating) ──────
    // `get` allows isEmailAllowed() to check a single doc by email ID
    // before sign-in; `list: false` prevents enumerating the collection.
    match /allowlist/{email} {
      allow get: if true;
      allow list: if false;
    }
  }
}
