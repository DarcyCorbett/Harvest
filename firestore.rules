rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profiles ───────────────────────────────────
    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Households ──────────────────────────────────────
    // Allow authenticated users to create households
    // Allow members to read their household
    // Allow listing for invite-code lookups during registration
    match /households/{householdId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members
            || request.auth.uid in request.resource.data.members);
      allow list: if request.auth != null;

      // Household subcollections — only members can access
      match /mealPlan/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      match /shoppingList/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      match /cookbook/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      match /settings/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }

    // ─── Recipes (Global Cache) ──────────────────────────
    // Any authenticated user can read/write recipes
    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }

    // ─── Allowlist (pre-auth read for email gating) ──────
    // `get` allows isEmailAllowed() to check a single doc by email ID
    // before sign-in; `list: false` prevents enumerating the collection.
    match /allowlist/{email} {
      allow get: if true;
      allow list: if false;
    }
  }
}
